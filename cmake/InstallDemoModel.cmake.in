# Check the model's lock at install time, then ship the data and its notices together.
set(_model_dir "@PROJECT_SOURCE_DIR@/models")
file(STRINGS "${_model_dir}/models.lock" _model_lock REGEX "^[0-9a-fA-F]")
set(_model_files deim_dfine_n_coco.onnx deim_dfine_n_coco.LICENSE deim_dfine_n_coco.NOTICE)
foreach(_name IN LISTS _model_files)
  set(_expected "")
  foreach(_line IN LISTS _model_lock)
    string(REGEX REPLACE "[ \t]+" ";" _fields "${_line}")
    list(LENGTH _fields _length)
    if(_length GREATER_EQUAL 3)
      list(GET _fields 1 _locked_name)
      if(_locked_name STREQUAL _name)
        if(NOT _expected STREQUAL "")
          message(FATAL_ERROR "Duplicate demo model lock entry: ${_name}")
        endif()
        list(GET _fields 0 _expected)
      endif()
    endif()
  endforeach()
  string(LENGTH "${_expected}" _hash_length)
  if(NOT _hash_length EQUAL 64 OR NOT _expected MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "Invalid or missing demo model lock entry: ${_name}")
  endif()
  if(NOT EXISTS "${_model_dir}/${_name}" OR IS_DIRECTORY "${_model_dir}/${_name}")
    message(FATAL_ERROR "Missing locked demo model file: ${_model_dir}/${_name}")
  endif()
  file(SHA256 "${_model_dir}/${_name}" _actual)
  string(TOLOWER "${_expected}" _expected)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Demo model file does not match models.lock: ${_name}")
  endif()
endforeach()
foreach(_name IN LISTS _model_files)
  file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}/@DEMO_MODEL_INSTALL_DIR@" TYPE FILE
       FILES "${_model_dir}/${_name}")
endforeach()
