# CPack runs this after producing packages, before copying them to the build directory.
set(_checked FALSE)
foreach(_package IN LISTS CPACK_PACKAGE_FILES)
  if(_package MATCHES "\\.AppImage$")
    execute_process(
      COMMAND
        "@CMAKE_COMMAND@" -E env "ORT_CHAIN_WHEEL_DIR=@_gpu_wheels@" "STRIP=@_gpu_strip@" bash
        "@CMAKE_CURRENT_SOURCE_DIR@/third_party/ANTfrastructure/linux/scripts/06-packaging/verify-ort-appimage-payload.sh"
        "${_package}" "@CMAKE_SYSTEM_PROCESSOR@" "usr/@CMAKE_INSTALL_LIBDIR@/accelerantgine"
        "usr/share/licenses/onnxruntime" "@KATAGLYPHIS_ORT_VARIANT@" COMMAND_ERROR_IS_FATAL ANY)
    set(_checked TRUE)
  endif()
endforeach()
if(CPACK_GENERATOR STREQUAL "AppImage" AND NOT _checked)
  message(FATAL_ERROR "CPack did not supply a finished GPU AppImage to verify")
endif()
