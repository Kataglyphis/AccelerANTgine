# do not track user specific vcpkg things
CMakeUserPresets.json

# The MSIX signing certificate lives at the repository root (Build-Windows.ps1's
# MSIX step signs with it); a private key must never be committed.
*.pfx

.flatpak-builder
*.AppImage
.cache
docs/source/api
# Generated by ci-coverage.sh in the same container step that builds the docs.
docs/coverage/
# Generated by ci-docs.sh / ci-build-and-test.sh; only docs/source/ is hand-written.
docs/_build_validation/
docs/build/
docs/test-results/
docs/test-results-md/
docs/source/test-results/*.md
docs/test_results*.xml
*.prof
scan-build-reports/

# Python bytecode. Test/python/__pycache__/*.pyc was tracked until 2026-09-15
# even though pytest rewrites it on every run; a rule here would not have
# stopped that on its own, because .gitignore does nothing once a path is
# already in the index.
__pycache__/
*.py[cod]

# Large binaries. Two are tracked ON PURPOSE and re-included below; the
# rationale is in AGENTS.md section 7 "Large tracked binaries". Everything else
# of that shape stays out, which is the point of the pattern plus its two
# exceptions: a second model dropped next to the first would otherwise be
# committed unnoticed.
*.onnx
!models/yolo26n.onnx
*.bmp
!images/Engine_logo.bmp

*.log

logs/
log/

docs/source/_static/*.svg
callgrind.out*
dist
.mypy_cache
.conda
build*/
build-*/
*.profraw


# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
# *.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# add build directory
build/*
out/*
.vs/*
.vscode/*




# uv-managed Python env for the docs/quality tooling (repo-local, never tracked;
# BeschleunigerBallett ignores the same path)
.venv/
