# Shell scripts MUST be LF regardless of anyone's core.autocrlf. They run only
# inside the Linux CI container, and a lone CR from a Windows checkout makes
# bash read `\r` as a command - "$'\r': command not found", exit 127 - which
# looks like a missing tool but is a line-ending fault.
*.sh    text eol=lf
*.bash  text eol=lf

# Workflows and CMake inputs are read on the Linux lanes; same reasoning.
.github/**/*.yml text eol=lf
CMakeLists.txt   text eol=lf
*.cmake          text eol=lf

# Windows-only scripts stay CRLF-friendly; they never run under bash.
*.ps1   text eol=crlf
*.psm1  text eol=crlf

# exclude all files from language analysis which do not directly contribute to engine
third_party/** linguist-vendored
build/** linguist-vendored

# Ratchet freeze files are read by the Linux gates; keep them LF.
*.allow text eol=lf
